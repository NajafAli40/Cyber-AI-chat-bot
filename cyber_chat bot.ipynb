# ============================================================
# Response Function
# ============================================================

def get_response(user_input):
    user_lower = user_input.lower()
    tokens = word_tokenize(user_lower)

    creator_triggers = [
        "who made you", "who created you", "who built you",
        "who developed you", "your creator", "who are you",
        "who is your creator", "who made this", "who are your developers"
    ]
    for trigger in creator_triggers:
        if trigger in user_lower:
            return CREATOR_RESPONSE

    for token in tokens:
        if token in knowledge_base:
            return knowledge_base[token]

    for keyword, response in knowledge_base.items():
        if keyword in user_lower:
            return response

    return ("❓ I don't have info on that yet.\n"
            "💡 Try: phishing, malware, password, ransomware, hacking,\n"
            "   vpn, firewall, antivirus, 2fa, encryption, scam,\n"
            "   darkweb, privacy, career, cloud, or type 'help'!")

